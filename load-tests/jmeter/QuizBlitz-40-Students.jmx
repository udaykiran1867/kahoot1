        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init Host Loop" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">vars.put(&apos;hostDone&apos;, &apos;false&apos;)
vars.put(&apos;hostStep&apos;, &apos;0&apos;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Advance Questions Until Finished" enabled="true">
          <stringProp name="WhileController.condition">${__groovy((vars.get(&apos;hostDone&apos;) != &apos;true&apos;) &amp;&amp; (((vars.get(&apos;hostStep&apos;) ?: &apos;0&apos;) as int) &lt; 60))}</stringProp>
