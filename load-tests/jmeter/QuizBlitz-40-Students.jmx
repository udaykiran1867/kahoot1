          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract gameId from Join" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">joinedGameId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.gameId</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract playerId from Join" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">joinedPlayerId</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.playerId</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init Student Loop" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">vars.put(&apos;keepRunning&apos;, &apos;true&apos;)
vars.put(&apos;canSubmitAnswer&apos;, &apos;false&apos;)
vars.put(&apos;pollCount&apos;, &apos;0&apos;)
vars.put(&apos;lastAnsweredQuestion&apos;, &apos;-1&apos;)
vars.put(&apos;currentQuestionIndex&apos;, &apos;-1&apos;)
vars.put(&apos;correctAnswerIndex&apos;, &apos;-1&apos;)
vars.put(&apos;finalAnswerIndex&apos;, &apos;0&apos;)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="Poll And Answer All Questions" enabled="true">
          <stringProp name="WhileController.condition">${__groovy((vars.get(&apos;keepRunning&apos;) == &apos;true&apos;) &amp;&amp; (((vars.get(&apos;pollCount&apos;) ?: &apos;0&apos;) as int) &lt; 1200))}</stringProp>
        </WhileController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET Game State" enabled="true">
            <stringProp name="HTTPSampler.path">/api/game/state</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
                <elementProp name="gameId" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.value">${joinedGameId}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">gameId</stringProp>
                </elementProp>
                <elementProp name="revealAnswers" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">true</boolProp>
                  <stringProp name="Argument.value">1</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                  <boolProp name="HTTPArgument.use_equals">true</boolProp>
                  <stringProp name="Argument.name">revealAnswers</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Evaluate State" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def polls = ((vars.get(&apos;pollCount&apos;) ?: &apos;0&apos;) as int) + 1
vars.put(&apos;pollCount&apos;, String.valueOf(polls))
vars.put(&apos;canSubmitAnswer&apos;, &apos;false&apos;)

if (prev.getResponseCode() != &apos;200&apos;) {
    return
}

def body = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(body)
def status = String.valueOf(json?.game?.status ?: &apos;&apos;)
if (status == &apos;finished&apos;) {
    vars.put(&apos;keepRunning&apos;, &apos;false&apos;)
    return
}

def qRaw = json?.game?.currentQuestion
def qIdx = (qRaw instanceof Number) ? (qRaw as int) : -1
def lastAnswered = (vars.get(&apos;lastAnsweredQuestion&apos;) ?: &apos;-1&apos;) as int
def correct = -1
def questions = json?.quiz?.questions

if (questions instanceof List &amp;&amp; qIdx &gt;= 0 &amp;&amp; qIdx &lt; questions.size()) {
    def cRaw = questions[qIdx]?.correctAnswer
    if (cRaw instanceof Number) {
        correct = cRaw as int
    }
}

vars.put(&apos;currentQuestionIndex&apos;, String.valueOf(qIdx))
vars.put(&apos;correctAnswerIndex&apos;, String.valueOf(correct))

def ready = (status == &apos;started&apos; &amp;&amp; qIdx &gt;= 0 &amp;&amp; correct &gt;= 0)
if (ready &amp;&amp; qIdx &gt; lastAnswered) {
    vars.put(&apos;canSubmitAnswer&apos;, &apos;true&apos;)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Submit New Question Answer" enabled="true">
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;canSubmitAnswer&apos;) == &apos;true&apos;)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set Correct Answer Index" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">def correctAnswerIndex = (vars.get(&apos;correctAnswerIndex&apos;) ?: &apos;0&apos;) as int
vars.put(&apos;finalAnswerIndex&apos;, String.valueOf(Math.max(0, correctAnswerIndex)))</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST Answer Question" enabled="true">
              <stringProp name="HTTPSampler.path">/api/game/answer</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;gameId&quot;:&quot;${joinedGameId}&quot;,&quot;playerId&quot;:&quot;${joinedPlayerId}&quot;,&quot;questionIndex&quot;:${currentQuestionIndex},&quot;answerIndex&quot;:${finalAnswerIndex}}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Answer Success" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-547797305">&quot;success&quot;:true</stringProp>
                </collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
                <stringProp name="Assertion.custom_message"></stringProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Mark Answered" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">if (prev.getResponseCode() == &apos;200&apos; || prev.getResponseCode() == &apos;409&apos;) {
    vars.put(&apos;lastAnsweredQuestion&apos;, vars.get(&apos;currentQuestionIndex&apos;) ?: &apos;-1&apos;)
}
vars.put(&apos;canSubmitAnswer&apos;, &apos;false&apos;)</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
